DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_EFFORT=high
AGENT_MAX_STEPS=12
AGENT_WEB_PORT=3000
AGENT_WEB_SEARCH_ENABLED=true
AGENT_CONTEXT_MAX_CHARS=30000
AGENT_OLD_TOOL_OUTPUT_MAX_CHARS=1500
AGENT_TOOL_OUTPUT_MAX_CHARS=12000
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_MODEL_PATH=C:\Users\your-name\.cache\chroma\onnx_models\all-MiniLM-L6-v2\onnx
CHROMA_DATA_PATH=.myagent\chroma
CHROMA_COLLECTION=myagent_knowledge
KNOWLEDGE_PATH=knowledge
